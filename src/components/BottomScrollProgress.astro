---
interface Props {
  isEnglish: boolean;
  pageLabel?: string;
}

const { isEnglish, pageLabel } = Astro.props;
const defaultLabel = pageLabel ?? (isEnglish ? 'Overview' : 'Inicio');
---

<script is:inline define:vars={{ defaultLabel }}>
  (() => {
    const header = document.querySelector('.site-header');
    const fill = document.getElementById('nav-scroll-progress');
    const projectsSection = document.getElementById('proyectos');
    const skillsSection = document.getElementById('tecnologias');
    const navProjects = document.querySelector('[data-nav-section="proyectos"]');
    const navSkills = document.querySelector('[data-nav-section="tecnologias"]');

    const updateScroll = () => {
      const scrollTop = window.scrollY || document.documentElement.scrollTop || 0;
      const scrollHeight = document.documentElement.scrollHeight - document.documentElement.clientHeight;
      const ratio = scrollHeight > 0 ? Math.min(1, Math.max(0, scrollTop / scrollHeight)) : 1;

      if (header) {
        header.classList.toggle('is-scrolled', scrollTop > 12);
      }
      if (fill) {
        fill.style.width = `${(ratio * 100).toFixed(2)}%`;
      }

      if (projectsSection && skillsSection && navProjects && navSkills) {
        const probeY = window.innerHeight * 0.42;
        const inSkills = skillsSection.getBoundingClientRect().top <= probeY;
        navProjects.classList.toggle('is-active', !inSkills);
        navSkills.classList.toggle('is-active', inSkills);
      }
    };

    window.addEventListener('scroll', updateScroll, { passive: true });
    window.addEventListener('resize', updateScroll, { passive: true });
    updateScroll();

    const revealEls = Array.from(document.querySelectorAll('.reveal-on-scroll'));
    if (revealEls.length > 0 && 'IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.08, rootMargin: '0px 0px -36px 0px' }
      );
      revealEls.forEach((el) => observer.observe(el));
    } else {
      revealEls.forEach((el) => el.classList.add('is-visible'));
    }
  })();
</script>
