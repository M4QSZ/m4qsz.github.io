---
import { profile } from '../data/profile';

interface Props {
  isEnglish: boolean;
  home: string;
  lab: string;
  cvPath: string;
  counterpart: string;
  pathname: string;
}

const { isEnglish, home, lab, cvPath, counterpart, pathname } = Astro.props;

const isLabActive = pathname.startsWith('/laboratorio') || pathname.startsWith('/en/lab') || pathname.startsWith('/muestras') || pathname.startsWith('/en/samples');
const isCvActive = pathname.startsWith('/cv') || pathname.startsWith('/en/cv');
const isHomeActive = !isLabActive && !isCvActive;

const navLinks = [
  { href: `${home}#proyectos`, label: isEnglish ? 'Projects' : 'Proyectos', active: isHomeActive, sectionId: 'proyectos' },
  { href: `${home}#tecnologias`, label: isEnglish ? 'Skills' : 'Tecnologías', active: false, sectionId: 'tecnologias' },
  { href: lab, label: isEnglish ? 'Lab' : 'Laboratorio', active: isLabActive },
  { href: cvPath, label: 'CV', active: isCvActive },
];
---

<header class="site-header">
  <div class="header-inner wrap">
    <a class="brand" href={home} aria-label={isEnglish ? 'Go to home' : 'Ir al inicio'}>
      <span class="brand-mark" aria-hidden="true">
        <svg viewBox="0 0 40 40" width="38" height="38" fill="none">
          <defs>
            <linearGradient id="mq-copper" x1="18" y1="12" x2="34" y2="30" gradientUnits="userSpaceOnUse">
              <stop offset="0%" stop-color="#f2bb88" />
              <stop offset="100%" stop-color="#c87b4b" />
            </linearGradient>
            <linearGradient id="mq-ivory" x1="6" y1="12" x2="22" y2="30" gradientUnits="userSpaceOnUse">
              <stop offset="0%" stop-color="#f7f5ef" />
              <stop offset="100%" stop-color="#c8cfc7" />
            </linearGradient>
          </defs>
          <path
            d="M8.5 29.5L13 13.5L20 22.8L17.2 26.8L13.6 21.8L11.8 29.5H8.5Z"
            fill="url(#mq-ivory)"
          />
          <path
            d="M20 22.8L27 13.5L31.5 29.5H28.2L26.4 21.8L20 30.2L17.2 26.8L20 22.8Z"
            fill="url(#mq-copper)"
          />
          <path
            d="M20 8.5L22.2 12L20 15.5L17.8 12L20 8.5Z"
            fill="#83c6a0"
          />
        </svg>
      </span>
      <span class="brand-name">
        <strong>{profile.shortName}</strong>
      </span>
    </a>

    <nav class="nav-pill-group" aria-label={isEnglish ? 'Main navigation' : 'Navegación principal'}>
      {navLinks.map((item) => (
        <a
          href={item.href}
          class:list={['nav-pill-link', item.active && 'is-active']}
          aria-current={item.active ? 'page' : undefined}
          data-nav-section={item.sectionId}
        >
          <span>{item.label}</span>
        </a>
      ))}
    </nav>

    <div class="header-actions">
      <div class="lang-switch" role="group" aria-label={isEnglish ? 'Language switch' : 'Cambio de idioma'}>
        {isEnglish ? (
          <>
            <a href={counterpart} lang="es" class="lang-opt" aria-label="Cambiar a español">ES</a>
            <span class="lang-opt is-current" aria-current="true">EN</span>
          </>
        ) : (
          <>
            <span class="lang-opt is-current" aria-current="true">ES</span>
            <a href={counterpart} lang="en" class="lang-opt" aria-label="Switch to English">EN</a>
          </>
        )}
      </div>

      <a class="header-github-link" href={profile.github} target="_blank" rel="noopener noreferrer">
        GitHub <span aria-hidden="true">↗</span>
      </a>

      <a class="header-contact-pill" href={`${home}#contacto`}>
        {isEnglish ? 'Contact' : 'Contacto'}
      </a>

      <button
        type="button"
        class="mobile-menu-btn"
        id="mobile-menu-toggle"
        aria-expanded="false"
        aria-controls="mobile-nav-drawer"
        aria-label={isEnglish ? 'Toggle navigation menu' : 'Abrir menú de navegación'}
      >
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>

  <nav
    id="mobile-nav-drawer"
    class="mobile-nav-drawer wrap"
    aria-label={isEnglish ? 'Mobile navigation' : 'Navegación móvil'}
    hidden
  >
    <div class="mobile-nav-links">
      {navLinks.map((item) => (
        <a href={item.href} class:list={['mobile-nav-item', item.active && 'is-active']}>
          <span>{item.label}</span>
        </a>
      ))}
    </div>
    <div class="mobile-nav-footer">
      <a href={`${home}#contacto`} class="mobile-cta">{isEnglish ? 'Contact Miguel' : 'Contactar'} →</a>
      <a href={profile.github} target="_blank" rel="noopener noreferrer" class="mobile-gh">GitHub ↗</a>
    </div>
  </nav>

  <div class="nav-progress-track" aria-hidden="true">
    <div class="nav-progress-fill" id="nav-scroll-progress"></div>
  </div>
</header>

<script is:inline>
  (() => {
    const toggle = document.getElementById('mobile-menu-toggle');
    const drawer = document.getElementById('mobile-nav-drawer');
    if (!toggle || !drawer) return;

    const header = toggle.closest('.site-header');
    const setOpen = (open) => {
      toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
      toggle.classList.toggle('is-open', open);
      if (header) header.classList.toggle('is-menu-open', open);
      drawer.hidden = !open;
    };

    toggle.addEventListener('click', () => {
      const next = toggle.getAttribute('aria-expanded') !== 'true';
      setOpen(next);
    });

    drawer.addEventListener('click', (event) => {
      if (event.target instanceof Element && event.target.closest('a')) {
        setOpen(false);
      }
    });
  })();
</script>
