---
import ProjectPreview from './ProjectPreview.astro';
import type { ProjectVariant } from '../data/profile';

interface Props {
  number: string;
  title: string;
  type: string;
  description: string;
  stack: string[];
  href: string;
  accent?: string;
  variant?: ProjectVariant;
  image?: string;
  secondaryImage?: string;
  imageAlt?: string;
  group?: string;
  isEnglish?: boolean;
  featured?: boolean;
  liveUrl?: string;
  repoUrl?: string;
}

const {
  number,
  title,
  type,
  description,
  stack,
  href,
  accent = 'orange',
  variant = 'screenshot',
  image,
  secondaryImage,
  imageAlt,
  group = 'systems',
  isEnglish = false,
  featured = false,
  liveUrl,
  repoUrl,
} = Astro.props;

const ctaLabel = isEnglish ? 'Read case study →' : 'Abrir caso técnico →';
const liveLabel = isEnglish ? 'Live site ↗' : 'Ver en vivo ↗';
const repoLabel = isEnglish ? 'Rust crate ↗' : 'Crate Rust ↗';
---

<article class:list={['project-card', `accent-${accent}`, 'reveal-on-scroll', featured && 'project-card--featured']} data-group={group}>
  <ProjectPreview
    number={number}
    title={title}
    accent={accent}
    image={image}
    secondaryImage={secondaryImage}
    imageAlt={imageAlt}
    variant={variant}
    isEnglish={isEnglish}
    caption={title}
  />
  <div class="project-copy">
    <p class="project-type">{type}</p>
    <h3><a href={href}>{title}</a></h3>
    <p>{description}</p>
    <p class="stack-line">{stack.join(' · ')}</p>
    <div class="card-cta-row">
      <a class="card-cta" href={href}>{ctaLabel}</a>
      {liveUrl && (
        <a class="card-ext-link card-ext-live" href={liveUrl} target="_blank" rel="noopener noreferrer">{liveLabel}</a>
      )}
      {repoUrl && (
        <a class="card-ext-link" href={repoUrl} target="_blank" rel="noopener noreferrer">{repoLabel}</a>
      )}
    </div>
  </div>
</article>
