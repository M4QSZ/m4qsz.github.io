---
interface Props {
  number: string;
  title: string;
  accent?: string;
  image?: string;
  secondaryImage?: string;
  imageAlt?: string;
  variant?: 'screenshot' | 'p2p' | 'modules' | 'mobile-clients' | 'mobile-delivery' | 'roblox' | 'ai-bevy';
  isEnglish?: boolean;
  caption?: string;
}

const {
  title,
  accent = 'orange',
  image,
  secondaryImage,
  imageAlt,
  variant = 'screenshot',
  isEnglish = false,
  caption,
} = Astro.props;

const zoomLabel = isEnglish ? 'Expand screenshot' : 'Ampliar captura';
---

<div class:list={['project-visual', `accent-${accent}`, image ? 'is-photo' : `is-${variant}`]}>
  {
    image ? (
      <div class="shot-stage">
        <button
          type="button"
          class="shot-zoom-trigger"
          data-lightbox-src={image}
          data-lightbox-alt={imageAlt || title}
          data-lightbox-caption={caption || title}
          aria-label={`${zoomLabel}: ${title}`}
        >
          <img src={image} alt={imageAlt || title} loading="lazy" decoding="async" class="shot-main" />
        </button>
        {secondaryImage && (
          <img src={secondaryImage} alt="" aria-hidden="true" loading="lazy" decoding="async" class="shot-pip" />
        )}
      </div>
    ) : variant === 'p2p' ? (
      <div class="schematic schematic-p2p" aria-hidden="true">
        <div class="schematic-head">
          <span class="schem-title">mDNS · UDP LAN</span>
          <span class="schem-status">Sync CRDT offline</span>
        </div>
        <div class="p2p-mesh">
          <div class="p2p-node is-primary">
            <strong>{isEnglish ? 'POS Register' : 'Caja POS'}</strong>
            <small>Rust · Isar</small>
          </div>
          <div class="p2p-link"><span>⇄</span></div>
          <div class="p2p-node">
            <strong>{isEnglish ? 'Kitchen KDS' : 'Cocina KDS'}</strong>
            <small>{isEnglish ? 'Live tickets' : 'Comandas'}</small>
          </div>
          <div class="p2p-link"><span>⇄</span></div>
          <div class="p2p-node">
            <strong>{isEnglish ? 'Bar / Mobile' : 'Barra / Móvil'}</strong>
            <small>{isEnglish ? 'Local LAN' : 'Red local'}</small>
          </div>
        </div>
      </div>
    ) : variant === 'modules' ? (
      <div class="schematic schematic-modules" aria-hidden="true">
        <div class="schematic-head">
          <span class="schem-title">Meson Store</span>
          <span class="schem-status">{isEnglish ? '44+ modules · Rust FFI' : '44+ módulos · Rust FFI'}</span>
        </div>
        <div class="module-tile-grid">
          <span class="mod-tile t-blue"><i>⊞</i>{isEnglish ? 'Inventory' : 'Inventario'}</span>
          <span class="mod-tile t-orange"><i>▤</i>{isEnglish ? 'Orders' : 'Comandera'}</span>
          <span class="mod-tile t-green"><i>◈</i>{isEnglish ? 'Finance' : 'Finanzas'}</span>
          <span class="mod-tile t-purple"><i>❖</i>{isEnglish ? 'Floors' : 'Salones'}</span>
          <span class="mod-tile t-gold"><i>★</i>{isEnglish ? 'Loyalty' : 'Fidelidad'}</span>
          <span class="mod-tile t-teal"><i>⚡</i>Meson IA</span>
        </div>
      </div>
    ) : variant === 'mobile-clients' ? (
      <div class="schematic schematic-mobile" aria-hidden="true">
        <div class="phone-mockup">
          <div class="phone-bar">
            <span>{isEnglish ? 'Meson Radar' : 'Radar Meson'}</span>
            <span>120 m</span>
          </div>
          <div class="phone-radar-box">
            <span class="radar-pin">{isEnglish ? 'Sushi Express · Table 4' : 'Sushi Express · Mesa 4'}</span>
            <span class="radar-pin">{isEnglish ? 'Central Roastery' : 'Café Central'}</span>
          </div>
          <div class="phone-cta-row">
            <span>Check-in QR</span>
            <span class="phone-action">{isEnglish ? 'Book' : 'Reservar'}</span>
          </div>
        </div>
        <div class="phone-meta">
          <strong>{isEnglish ? 'Live floor discovery' : 'Radar en tiempo real'}</strong>
          <small>{isEnglish ? 'Open tables, live menus, and check-in directly from the floor.' : 'Mesas abiertas, carta viva y check-in desde el salón.'}</small>
        </div>
      </div>
    ) : variant === 'mobile-delivery' ? (
      <div class="schematic schematic-mobile" aria-hidden="true">
        <div class="phone-mockup">
          <div class="phone-bar">
            <span>{isEnglish ? 'Active route' : 'Ruta activa'}</span>
            <span>3 / 4</span>
          </div>
          <div class="delivery-stops">
            <div class="stop done">{isEnglish ? 'Order #104 · Delivered' : 'Pedido #104 · Entregado'}</div>
            <div class="stop active">{isEnglish ? 'Order #108 · En route' : 'Pedido #108 · En camino'}</div>
            <div class="stop">{isEnglish ? 'Offline queue synced' : 'Cola offline lista'}</div>
          </div>
          <div class="phone-cta-row">
            <span>GPS + Isar</span>
            <span class="phone-action">{isEnglish ? 'Sign' : 'Firmar'}</span>
          </div>
        </div>
        <div class="phone-meta">
          <strong>{isEnglish ? 'Resilient dispatch' : 'Despacho resiliente'}</strong>
          <small>{isEnglish ? 'Works in zero-signal zones and reconciles states on reconnect.' : 'Opera en zonas sin cobertura y reconcilia estados al volver.'}</small>
        </div>
      </div>
    ) : variant === 'roblox' ? (
      <div class="schematic schematic-roblox" aria-hidden="true">
        <div class="schematic-head">
          <span class="schem-title">Roblox · Rojo · Luau</span>
          <span class="schem-status">ReplicatedStorage</span>
        </div>
        <div class="lighthouse-scene">
          <div class="lighthouse-beam"></div>
          <div class="lighthouse-tower">
            <span class="beacon-glow"></span>
          </div>
          <div class="lighthouse-waves"></div>
          <div class="roblox-nodes">
            <span>ServerScriptService</span>
            <span>StarterPlayer</span>
          </div>
        </div>
      </div>
    ) : (
      <div class="schematic schematic-ai" aria-hidden="true">
        <div class="schematic-head">
          <span class="schem-title">Meson IA + Bevy ECS</span>
          <span class="schem-status">Rust · Tool Calling</span>
        </div>
        <div class="ai-split">
          <div class="ai-card">
            <strong>{isEnglish ? 'Ops Assistant' : 'Asistente operativo'}</strong>
            <span class="ai-cmd">&gt; cierre_caja("night")</span>
            <small>{isEnglish ? 'Voice intent validation' : 'Voz, intención y validación'}</small>
          </div>
          <div class="ai-card is-engine">
            <strong>Bevy World</strong>
            <span class="ai-cmd">Query&lt;(&amp;Pos, &amp;Vel)&gt;</span>
            <small>{isEnglish ? 'Parallel systems' : 'Sistemas paralelos en Rust'}</small>
          </div>
        </div>
      </div>
    )
  }
</div>
