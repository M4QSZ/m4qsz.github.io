---
interface Props {
  isEnglish?: boolean;
}

const { isEnglish = false } = Astro.props;

const frames = isEnglish
  ? [
      {
        src: '/images/meson-shell.webp',
        alt: 'Meson Desktop 44-module launcher with snapped 2.5D Tables and System Health windows',
        caption: 'Meson Desktop: 44-module launcher, snapped 2.5D Salon and System Health.',
        label: 'Desktop shell',
      },
      {
        src: '/images/meson-floor-editor.webp',
        alt: 'Meson isometric floor editor in Flutter + Flame',
        caption: 'Interactive isometric floor editor with multi-floor view in Flame.',
        label: 'Isometric tables',
      },
      {
        src: '/images/meson-widgets.webp',
        alt: 'Meson live widgets board and news drawer',
        caption: 'Live widgets workspace and internal El Diario feed.',
        label: 'Live widgets',
      },
      {
        src: '/images/meson-web-devices.webp',
        alt: 'Meson multi-device responsive web showcase',
        caption: 'Multiplatform web views across desktop, tablet and mobile.',
        label: 'Multi-device web',
      },
    ]
  : [
      {
        src: '/images/meson-shell.webp',
        alt: 'Escritorio de Meson con 44 módulos y ventanas acopladas de Salón 2.5D y Salud del sistema',
        caption: 'Meson Desktop: lanzador de 44 módulos con ventanas acopladas en vivo.',
        label: 'Shell escritorio',
      },
      {
        src: '/images/meson-floor-editor.webp',
        alt: 'Editor isométrico de mesas en Meson Desktop',
        caption: 'Editor visual isométrico 2.5D con selector de pisos en Flame.',
        label: 'Editor isométrico',
      },
      {
        src: '/images/meson-widgets.webp',
        alt: 'Tablero de widgets en vivo y El Diario en Meson',
        caption: 'Tablero de widgets operativos y noticias internas en vivo.',
        label: 'Widgets en vivo',
      },
      {
        src: '/images/meson-web-devices.webp',
        alt: 'Meson web adaptado a escritorio, tablet y móvil',
        caption: 'Plataforma web comercial adaptada a escritorio, tablet y teléfono.',
        label: 'Web adaptativa',
      },
    ];

const initial = frames[0];
---

<div class="hero-showcase" data-hero-stage aria-label={isEnglish ? 'Interactive software gallery' : 'Galería interactiva de interfaces'}>
  <div class="showcase-frame">
    <button
      type="button"
      class="showcase-trigger"
      data-stage-zoom
      data-lightbox-src={initial.src}
      data-lightbox-alt={initial.alt}
      data-lightbox-caption={initial.caption}
      aria-label={isEnglish ? 'Expand active screenshot' : 'Ampliar captura activa'}
    >
      <img
        data-stage-img
        src={initial.src}
        alt={initial.alt}
        width="1280"
        height="800"
        loading="eager"
        fetchpriority="high"
        decoding="sync"
      />
    </button>
  </div>

  <div class="showcase-thumbs" role="tablist" aria-label={isEnglish ? 'Select product view' : 'Seleccionar vista del sistema'}>
    {frames.map((frame, index) => (
      <button
        type="button"
        role="tab"
        aria-selected={index === 0 ? 'true' : 'false'}
        class:list={['showcase-thumb', index === 0 && 'is-active']}
        data-stage-tab
        data-src={frame.src}
        data-alt={frame.alt}
        data-caption={frame.caption}
      >
        <img
          src={frame.src}
          alt=""
          aria-hidden="true"
          width="1280"
          height="800"
          loading="eager"
          decoding="sync"
        />
        <span>{frame.label}</span>
      </button>
    ))}
  </div>
</div>

<script is:inline>
  (() => {
    const root = document.querySelector('[data-hero-stage]');
    if (!root) return;
    const img = root.querySelector('[data-stage-img]');
    const zoom = root.querySelector('[data-stage-zoom]');
    const tabs = Array.from(root.querySelectorAll('[data-stage-tab]'));
    if (!(img instanceof HTMLImageElement) || !(zoom instanceof HTMLButtonElement)) return;

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const src = tab.getAttribute('data-src');
        const alt = tab.getAttribute('data-alt') || '';
        const caption = tab.getAttribute('data-caption') || alt;
        if (!src || img.getAttribute('src') === src) return;

        tabs.forEach((item) => {
          const active = item === tab;
          item.classList.toggle('is-active', active);
          item.setAttribute('aria-selected', String(active));
        });

        img.classList.add('is-switching');
        window.setTimeout(() => {
          img.src = src;
          img.alt = alt;
          zoom.setAttribute('data-lightbox-src', src);
          zoom.setAttribute('data-lightbox-alt', alt);
          zoom.setAttribute('data-lightbox-caption', caption);
          img.classList.remove('is-switching');
        }, 90);
      });
    });
  })();
</script>
