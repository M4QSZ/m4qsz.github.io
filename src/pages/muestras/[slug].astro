---
import Base from '../../layouts/Base.astro';
import { labSamples } from '../../data/labSamples';

export function getStaticPaths() {
  return labSamples.map((sample) => ({ params: { slug: sample.slug }, props: { sample } }));
}

const { sample } = Astro.props;
const details = sample.es;
---
<Base title={`${details.title} | Laboratorio de Miguel Quevedo`} description={details.lead}>
  <main id="contenido" class="detail-main wrap">
    <a class="back-link" href="/laboratorio/">← Volver al laboratorio</a>
    <div class="detail-hero">
      <h1 class="long-title">{details.title}</h1>
      <p class="detail-lede">{details.lead}</p>
    </div>
    <div class="detail-meta">
      <div><span>Tecnologías</span><strong>{sample.stack.join(' · ')}</strong></div>
      <div><span>Estado</span><strong>{sample.verified ? 'Verificada localmente' : 'Pruebas pendientes'}</strong></div>
      <div><span>Ubicación</span><strong>samples/{sample.folder}</strong></div>
    </div>
    <div class="case-layout">
      <aside><span>Problema</span><span>Decisión</span><span>Verificación</span><span>Límites</span></aside>
      <div class="case-content">
        <section><h2>Qué resuelve</h2><p>{details.problem}</p></section>
        <section><h2>Cómo está planteado</h2><p>{details.decision}</p></section>
        <section><h2>Cómo comprobarlo</h2><p>{details.verification}</p><pre class="sample-code"><code>{details.command}</code></pre><p>El código está en <code>samples/{sample.folder}</code> dentro de este repositorio independiente.</p></section>
        <section><h2>Alcance de la muestra</h2><p>{details.limits}</p><p>Miguel debe revisar y poder explicar personalmente este código antes de usarlo como evidencia profesional.</p></section>
      </div>
    </div>
  </main>
</Base>
