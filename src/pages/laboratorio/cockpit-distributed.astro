    <div class="paper-kpis-wrap">
      <div class="paper-kpis" aria-label="Invariantes de transporte y seguridad multi-dispositivo">
        <div class="paper-kpi"><strong>HMAC-SHA256</strong><span>API Hyper <code>/v1/*</code> en <code>:47823</code> + OTP QR + <code>ct_eq</code></span></div>
