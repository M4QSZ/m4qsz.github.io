---
import Base from '../../layouts/Base.astro';
import paperHtml from '../../data/certifiedArithPaper.html?raw';
---
<Base
  title="Certified Arithmetic Preprocessing for Scrambled CNF | Miguel Quevedo"
  description="Research prototype and technical note: VeriPB-certified arithmetic adder extraction and dual annihilator preprocessing for scrambled CNF; 30 Lean 4 theorems (0 axioms), 5/5 VeriPB 3.0.2 checks, 300 s comparison vs Kissat 4.0.4 and CryptoMiniSat 5."
  pageLabel="Paper · Certified Arithmetic Preprocessing"
>
  <main id="contenido" class="detail-main wrap paper-wide">
    <a class="back-link" href="/laboratorio/">← Volver al laboratorio técnico</a>
    <div class="detail-hero">
      <h1 class="long-title">Certified Arithmetic Preprocessing for Scrambled CNF</h1>
      <p class="detail-lede">Technical Note / borrador de preprint v0.1 — sin revisión por pares. El texto técnico está en inglés; todos los números provienen de ejecuciones registradas en el repositorio público.</p>
    </div>
    <div class="detail-meta">
      <div><span>Author &amp; date</span><strong>M4QSZ · November 2026 (v0.1)</strong></div>
      <div><span>Verification</span><strong>Lean 4: 30 theorems, 0 axioms · veripb 3.0.2: 5/5 VERIFIED UNSATISFIABLE</strong></div>
      <div><span>Status</span><strong>Research Prototype · Technical Note</strong></div>
    </div>
    <div class="cv-actions">
      <a class="button button-primary" href="https://github.com/M4QSZ/certified-arith-preproc" target="_blank" rel="noopener noreferrer">Repository + reproduce.sh ↗</a>
      <a class="button button-outline" href="https://github.com/M4QSZ/certified-arith-preproc/blob/main/TECHNICAL_NOTE.md" target="_blank" rel="noopener noreferrer">Markdown source ↗</a>
    </div>
    <article class="paper-body" set:html={paperHtml} />
  </main>
</Base>
