---
import Base from '../../layouts/Base.astro';
import paperHtml from '../../data/certifiedArithPaper.es.html?raw';
---
<Base
  title="Preprocesamiento Aritmético Certificado para CNF Permutada | Miguel Quevedo"
  description="Prototipo de investigación y nota técnica: extracción aritmética de sumadores certificada con VeriPB y preprocesamiento por aniquiladores duales para CNF permutada; 30 teoremas en Lean 4 (0 axiomas), 5/5 verificaciones VeriPB 3.0.2, comparación de 300 s contra Kissat 4.0.4 y CryptoMiniSat 5."
  pageLabel="Paper · Certified Arithmetic Preprocessing"
>
  <main id="contenido" class="detail-main wrap paper-wide">
    <a class="back-link" href="/laboratorio/">← Volver al laboratorio técnico</a>
    <div class="detail-hero">
      <h1 class="long-title">Preprocesamiento Aritmético Certificado para CNF Permutada</h1>
      <p class="detail-lede">Nota Técnica / borrador de preprint v0.1 — sin revisión por pares. Todas las cifras provienen de comandos ejecutados y registrados en el repositorio público.</p>
    </div>
    <div class="detail-meta">
      <div><span>Autor y fecha</span><strong>M4QSZ · Noviembre 2026 (v0.1)</strong></div>
      <div><span>Verificación</span><strong>Lean 4: 30 teoremas, 0 axiomas · veripb 3.0.2: 5/5 VERIFIED UNSATISFIABLE</strong></div>
      <div><span>Estado</span><strong>Prototipo de investigación · Nota Técnica</strong></div>
    </div>
    <div class="cv-actions">
      <a class="button button-primary" href="/papers/certified-arith-preproc.pdf" target="_blank" rel="noopener noreferrer">Descargar PDF ↗</a>
      <a class="button button-outline" href="https://github.com/M4QSZ/certified-arith-preproc" target="_blank" rel="noopener noreferrer">Repositorio + reproduce.sh ↗</a>
      <a class="button button-outline" href="https://github.com/M4QSZ/certified-arith-preproc/blob/main/TECHNICAL_NOTE.md" target="_blank" rel="noopener noreferrer">Fuente en Markdown (EN) ↗</a>
    </div>
    <article class="paper-body" set:html={paperHtml} />
  </main>
</Base>
