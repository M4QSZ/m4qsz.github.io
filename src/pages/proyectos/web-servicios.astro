---
import Base from '../../layouts/Base.astro';
import ProjectDetailGallery from '../../components/ProjectDetailGallery.astro';

const gallery = [
  { src: '/images/web-servicios.webp', alt: 'Captura del sitio web de servicios técnicos construido en Astro y Tailwind CSS', caption: 'Hero comercial y métricas rápidas configuradas desde archivo central.' },
];
---
<Base title="Web de servicios técnicos | Miguel" description="Sitio profesional en Astro y Tailwind CSS para servicios eléctricos y climatización." pageLabel="07 · Web servicios">
  <main id="contenido" class="detail-main wrap">
    <a class="back-link" href="/">← Volver al portafolio</a>
    <div class="detail-hero"><div><h1 class="long-title">Servicios web</h1><p class="detail-lede">Un sitio profesional para presentar servicios, trabajos y canales de contacto con claridad.</p></div></div>
    <div class="detail-meta"><div><span>Contenido</span><strong>Servicios y proyectos</strong></div><div><span>Contacto</span><strong>WhatsApp y teléfono</strong></div><div><span>Implementación</span><strong>Astro y Tailwind CSS</strong></div></div>
    <ProjectDetailGallery images={gallery} />
    <div class="case-layout"><aside><span>Objetivo</span><span>Estructura</span><span>Mantenimiento</span><span>Alcance</span></aside><div class="case-content">
      <section><h2>Explicar una oferta técnica</h2><p>La página organiza servicios de electricidad y climatización, trayectoria, proceso de trabajo, testimonios, galería y formas de contacto.</p></section>
      <section><h2>Componentes reutilizables</h2><p>El sitio usa Astro, Tailwind CSS y componentes separados para cabecera, servicios, proyectos, testimonios y contacto. La navegación se adapta a pantallas pequeñas.</p></section>
      <section><h2>Datos clave en un solo lugar</h2><p>Una configuración central reúne nombre, zona, horarios y canales de contacto; esto facilita cambiar la información sin buscarla por toda la interfaz.</p></section>
      <section><h2>Un caso de diseño y desarrollo</h2><p>Este caso describe la implementación que encontré en el repositorio local. No incluye métricas de tráfico, captación de clientes ni resultados comerciales no verificados.</p></section>
    </div></div>
    <div class="detail-actions">
      <a class="button button-primary" href="https://set-ingenieria.vercel.app" target="_blank" rel="noopener noreferrer">Abrir sitio en vivo (Vercel) ↗</a>
      <a class="button button-outline" href="/">Volver a proyectos ↗</a>
    </div>
  </main>
</Base>
