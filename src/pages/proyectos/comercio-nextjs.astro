---
import Base from '../../layouts/Base.astro';
import ProjectDetailGallery from '../../components/ProjectDetailGallery.astro';

const gallery = [
  { src: '/images/alma-storefront.webp', alt: 'Portada principal de Alma construida en Next.js y Tailwind CSS', caption: 'Vista principal del storefront con buscador en cabecera y colección destacada.' },
  { src: '/images/alma-catalog.webp', alt: 'Grilla de colecciones de Alma con tarjetas interactivas', caption: 'Sección de categorías y colecciones curadas en Next.js + Supabase.' },
];
---
<Base title="Alma — Comercio web en Next.js | Miguel" description="Caso de estudio de Alma: plataforma e-commerce construida con Next.js, React, TypeScript y Supabase." pageLabel="06 · Alma Next.js">
  <main id="contenido" class="detail-main wrap">
    <a class="back-link" href="/">← Volver al portafolio</a>
    <div class="detail-hero"><div><p class="section-kicker">WEB / COMERCIO / 06</p><h1 class="long-title">Alma<span>.</span></h1><p class="detail-lede">Plataforma e-commerce estilo marketplace construida con Next.js, React, TypeScript y Supabase como proyecto independiente de Meson.</p></div><div class="detail-badge">NEXT.JS + REACT<br /><strong>E-COMMERCE ALMA</strong></div></div>
    <div class="detail-meta"><div><span>INTERFAZ</span><strong>Catálogo y Fuse.js</strong></div><div><span>GESTIÓN</span><strong>Admin + Recharts + Resend</strong></div><div><span>DATOS</span><strong>Supabase</strong></div></div>
    <ProjectDetailGallery images={gallery} />
    <div class="case-layout"><aside><span>01 / PRODUCTO</span><span>02 / ARQUITECTURA</span><span>03 / ADMINISTRACIÓN</span><span>04 / ALCANCE</span></aside><div class="case-content">
      <section><p class="section-kicker">01 / PRODUCTO</p><h2>Del descubrimiento al pedido.</h2><p>Alma reúne página de inicio, colecciones, categorías, fichas de producto, búsqueda, carrito, cuentas y seguimiento de pedidos usando React, TypeScript y Next.js.</p></section>
      <section><p class="section-kicker">02 / ARQUITECTURA</p><h2>Contenido y datos conectados.</h2><p>Supabase aporta autenticación y datos del catálogo. El código incluye acciones de servidor, búsqueda difusa con Fuse.js, correos transaccionales con Resend, gráficas con Recharts, metadatos SEO, mapa del sitio y datos estructurados.</p></section>
      <section><p class="section-kicker">03 / ADMINISTRACIÓN</p><h2>Herramientas para operar la tienda.</h2><p>El panel reúne inventario, categorías, colecciones, pedidos, promociones, banners, métricas y configuración SEO. Hay roles y permisos definidos para separar las áreas de trabajo.</p></section>
      <section><p class="section-kicker">04 / ALCANCE ACTUAL</p><h2>Un flujo de compra en desarrollo.</h2><p>El checkout presente en el repositorio simula el procesamiento del pago. Por eso este caso demuestra la construcción de la experiencia y del panel, sin presentarlo como una pasarela de cobro real ni como una tienda validada para producción.</p></section>
    </div></div>
    <div class="detail-actions"><a class="button button-outline" href="/proyectos/meson/">Ver Meson ↗</a><a class="button button-outline" href="/">Volver a proyectos ↗</a></div>
  </main>
</Base>
