---
import Base from '../../../layouts/Base.astro';
import { labSamples } from '../../../data/labSamples';

export function getStaticPaths() {
  return labSamples.map((sample) => ({ params: { slug: sample.slug }, props: { sample } }));
}

const { sample } = Astro.props;
const details = sample.en;
---
<Base lang="en" title={`${details.title} | Miguel Quevedo's lab`} description={details.lead}>
  <main id="contenido" class="detail-main wrap">
    <a class="back-link" href="/en/lab/">← Back to lab</a>
    <div class="detail-hero">
      <h1 class="long-title">{details.title}</h1>
      <p class="detail-lede">{details.lead}</p>
    </div>
    <div class="detail-meta">
      <div><span>Stack</span><strong>{sample.stack.join(' · ')}</strong></div>
      <div><span>Status</span><strong>{sample.verified ? 'Locally verified' : 'Tests pending'}</strong></div>
      <div><span>Location</span><strong>samples/{sample.folder}</strong></div>
    </div>
    <div class="case-layout">
      <aside><span>Problem</span><span>Decision</span><span>Verification</span><span>Limits</span></aside>
      <div class="case-content">
        <section><h2>What it solves</h2><p>{details.problem}</p></section>
        <section><h2>How it works</h2><p>{details.decision}</p></section>
        <section><h2>How to check it</h2><p>{details.verification}</p><pre class="sample-code"><code>{details.command}</code></pre><p>The source is in <code>samples/{sample.folder}</code> within this independent repository.</p></section>
        <section><h2>Scope</h2><p>{details.limits}</p><p>Miguel should personally review and explain this code before using it as professional evidence.</p></section>
      </div>
    </div>
  </main>
</Base>
