---
import Base from '../../layouts/Base.astro';
import { profile } from '../../data/profile';
import { englishProjects } from '../../data/english';

const featured = englishProjects.filter((project) => ['01', '06', '07', '08'].includes(project.number));
const gamesAndAi = englishProjects.filter((project) => ['11', '12', '13'].includes(project.number));
const systems = englishProjects.filter((project) => ['02', '03', '04', '05', '09', '10'].includes(project.number));
---
<Base lang="en" title={`${profile.name} — Multiplatform Software & Game Engineer`} description="Miguel Quevedo's portfolio: multiplatform apps (desktop, mobile, web) in Flutter and Rust, Unity C# & Roblox Luau games, Next.js/Astro web, and applied AI.">
  <main id="contenido">
    <section class="hero wrap">
      <div class="hero-copy">
        <div class="eyebrow"><span class="status-dot"></span> Open to remote roles</div>
        <p class="hero-index">PORTFOLIO / 2026</p>
        <h1>From product idea.<br /><em>To working software.</em></h1>
        <p class="hero-lede">I build multiplatform software (desktop, mobile and web) with Flutter, Dart and Rust, plus games in Unity (C#) and web platforms with Next.js and Astro.</p>
        <div class="hero-actions">
          <a class="button button-primary" href="#proyectos">Explore projects ↘</a>
          <a class="button button-outline" href="/en/cv/">View / Print CV ↗</a>
          <a class="button button-outline" href={profile.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a>
        </div>
      </div>
      <div class="hero-visual" aria-label="Diagram showing product, interface, systems and game layers">
        <div class="visual-top"><span>HOW I WORK</span><span>01 / 04</span></div>
        <div class="visual-orbit orbit-one"></div><div class="visual-orbit orbit-two"></div>
        <div class="visual-center"><span>FROM IDEA</span><strong>TO SOFTWARE</strong><span>THAT WORKS</span></div>
        <div class="visual-node node-a">01 <strong>PRODUCT</strong></div><div class="visual-node node-b">02 <strong>INTERFACE</strong></div><div class="visual-node node-c">03 <strong>SYSTEMS</strong></div><div class="visual-node node-d">04 <strong>GAMES</strong></div>
        <div class="visual-bottom"><span>Desktop · Mobile · Web · Engines</span><span>↗</span></div>
      </div>
    </section>

    <div class="ticker" aria-label="Areas of work"><div>DESKTOP / MOBILE / WEB <span>✳</span> FLUTTER + RUST <span>✳</span> P2P / OFFLINE <span>✳</span> UNITY C# <span>✳</span> SQL / NOSQL <span>✳</span> AI / LLMS</div></div>

    <section class="proof-strip wrap" aria-label="Selected strengths">
      <div><span>01 / SYSTEMS</span><strong>Local P2P network</strong><p>Device communication with deferred sync and Firebase → Supabase migration.</p></div>
      <div><span>02 / MULTIPLATFORM</span><strong>Flutter + Rust + Kotlin</strong><p>Desktop, mobile and web apps connected to native FFI logic.</p></div>
      <div><span>03 / GAMES</span><strong>Unity C# · Flutter · Roblox</strong><p>Decoupled C# core with automated tests, shared Flutter package and Luau.</p></div>
    </section>

    <section class="section wrap" id="proyectos">
      <div class="section-heading"><div><p class="section-kicker">01 / WORK</p><h2>Products with<br /><em>real context.</em></h2></div><p>Independent products, Meson subsystems, and multiplatform game development.</p></div>
      <div class="project-grid">{featured.map((project) => <a class={`project-card accent-${project.accent}`} href={`/en/projects/${project.slug}/`}><div class="project-top"><span>{project.number} / PROJECT</span><span class="card-arrow" aria-hidden="true">↗</span></div><div class="project-art" aria-hidden="true"><span class="art-frame"><span class="art-grid"></span><span class="art-symbol">{project.number === '01' ? 'M' : project.number === '06' ? 'N' : '◇'}</span></span></div><div class="project-copy"><p class="project-type">{project.type}</p><h3>{project.title}</h3><p>{project.description}</p><div class="tags">{project.stack.map((skill) => <span>{skill}</span>)}</div></div></a>)}</div>

      <div class="subsection-heading"><p class="section-kicker">GAMES & APPLIED AI</p><h3>Interactive engines and prototypes.</h3><p>Brasas in both Flutter and Unity, El Pueblo del Faro in Roblox Studio, plus LLM tooling and Rust Bevy.</p></div>
      <div class="project-grid">
        {gamesAndAi.map((project) => (
          <a class={`project-card accent-${project.accent}`} href={`/en/projects/${project.slug}/`}>
            <div class="project-top"><span>{project.number} / INTERACTIVE</span><span class="card-arrow" aria-hidden="true">↗</span></div>
            {project.images?.[0] ? (
              <div class="project-thumb"><img src={project.images[0].src} alt={project.images[0].alt} loading="lazy" /></div>
            ) : (
              <div class="project-art" aria-hidden="true"><span class="art-frame"><span class="art-grid"></span><span class="art-symbol">{project.number === '12' ? '◈' : 'λ'}</span></span></div>
            )}
            <div class="project-copy"><p class="project-type">{project.type}</p><h3>{project.title}</h3><p>{project.description}</p><div class="tags">{project.stack.map((skill) => <span>{skill}</span>)}</div></div>
          </a>
        ))}
      </div>

      <div class="subsection-heading"><p class="section-kicker">INSIDE MESON</p><h3>Architecture and interfaces.</h3><p>Technical cases from one private product, without exposing its code or data.</p></div>
      <div class="project-grid">{systems.map((project) => <a class={`project-card accent-${project.accent}`} href={`/en/projects/${project.slug}/`}><div class="project-top"><span>{project.number} / SYSTEM</span><span class="card-arrow" aria-hidden="true">↗</span></div><div class="project-art" aria-hidden="true"><span class="art-frame"><span class="art-grid"></span><span class="art-symbol">{project.number === '02' ? '↔' : project.number === '03' ? '◫' : project.number === '04' ? '▣' : '◇'}</span></span></div><div class="project-copy"><p class="project-type">{project.type}</p><h3>{project.title}</h3><p>{project.description}</p><div class="tags">{project.stack.map((skill) => <span>{skill}</span>)}</div></div></a>)}</div>
    </section>

    <section class="section skills-section" id="tecnologias"><div class="wrap"><div class="section-heading"><div><p class="section-kicker">02 / EXPERTISE</p><h2>Tools for<br /><em>each layer.</em></h2></div><p>Active verified stack separated clearly from prior coursework and pre-Git experience.</p></div>
      <div class="capability-grid capability-grid-3">
        <div class="capability-card"><div class="capability-number">01</div><h3>Multiplatform & systems</h3><p>Desktop (Windows), mobile and web with modular code, Skia/Impeller engines, FFI, persistence and Git.</p><div class="skill-list">{['Dart','Flutter','Skia / Impeller','Rust','Flutter Rust Bridge','Kotlin','Isar','LAN P2P / UDP / TCP','Git','Git LFS'].map((skill) => <span>{skill}</span>)}</div></div>
        <div class="capability-card"><div class="capability-number">02</div><h3>Web, databases & AI</h3><p>Web platforms, relational/NoSQL modeling, Firebase/Firestore → Supabase/PostgreSQL migration and LLMs.</p><div class="skill-list">{['TypeScript','JavaScript','HTML','CSS','Next.js','React','Astro','Python','PostgreSQL','Supabase','MySQL','SQLite','Cloud Firestore','Firebase','LLMs / Meson IA'].map((skill) => <span>{skill}</span>)}</div></div>
        <div class="capability-card"><div class="capability-number">03</div><h3>Games, teamwork & quality</h3><p>Active game engines, project coordination, bug hunting & AppSec hardening, Godot familiarity and pre-Git languages.</p><div class="skill-list">{['Unity','C#','Flame','Roblox Studio','Luau / Lua','Bevy (Rust)','Godot (familiar)','Project coordination','Teamwork','Debugging / AppSec','C / C++','Java','PHP / Laravel','Django'].map((skill) => <span>{skill}</span>)}</div></div>
      </div>
      <p class="skills-note">Languages: Spanish & English (bilingual / 100%), Portuguese & Italian (advanced), German & Japanese (basic). The lab adds Rust, C, Assembly, C++, Swift and PHP examples with explicit verification status.</p>
    </div></section>

    <section class="section wrap architecture-section"><div class="section-heading"><div><p class="section-kicker">03 / ARCHITECTURE</p><h2>Built for unstable<br /><em>connections.</em></h2></div><p>Local operations do not depend on cloud availability for every action.</p></div><div class="architecture-grid"><div class="architecture-diagram" aria-label="Point of sale, floor and kitchen devices communicate locally, then synchronize remotely"><div class="diagram-label">MESON / LOCAL NETWORK</div><div class="diagram-devices"><span>POS</span><span>FLOOR</span><span>KITCHEN</span></div><div class="diagram-flow">↔ &nbsp; DISCOVERY + P2P MESSAGES &nbsp; ↔</div><div class="diagram-store">LOCAL DATA AND QUEUE</div><div class="diagram-arrow">↓ when connected</div><div class="diagram-cloud">REMOTE SYNC</div></div><div class="architecture-copy"><div><span>01</span><h3>Local work</h3><p>Devices can exchange changes over the restaurant network during an Internet outage.</p></div><div><span>02</span><h3>Native network layer</h3><p>The Rust engine implements encrypted envelopes and replay controls.</p></div><div><span>03</span><h3>NoSQL ↔ SQL migration</h3><p>Hands-on data modeling across Isar, SQLite, MySQL and migrating Firebase / Cloud Firestore into Supabase / PostgreSQL.</p></div><a class="text-link" href="/en/projects/red-p2p/">Explore the architecture ↗</a></div></div><p class="architecture-caveat">During a power outage, devices need batteries and the local network needs backup power.</p></section>

    <section class="section wrap about-section" id="sobre-mi"><div><p class="section-kicker">04 / APPROACH</p><h2>Clean modules.<br /><em>Broad delivery.</em></h2></div><div class="about-copy"><p>I keep files concise and modular, separating UI from business logic with explicit dependency injection. Final-year Systems Engineering (Programming Concentration) student at Universidad Bicentenaria de Aragua (expected graduation: July 2027).</p><p>I have led most of Meson's design and implementation across desktop, mobile and web, and supervised a Flutter collaborator's work. Full Meson source stays private; this site presents architecture, real Brasas captures and public code samples.</p><a class="text-link" href="/en/projects/meson/">Read the Meson case ↗</a></div></section>

    <section class="contact-section"><div class="wrap contact-inner"><p class="section-kicker">05 / CONTACT</p><h2>Let's build<br /><em>useful software.</em></h2><p>{profile.locationEn} · Open to remote opportunities.</p><div class="contact-actions"><a class="button button-primary" href={`mailto:${profile.email}`}>Email ({profile.email}) ↗</a><a class="button button-outline" href={profile.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn ↗</a><a class="button button-outline" href={profile.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a><a class="button button-outline" href="/en/cv/">CV / PDF ↗</a></div></div></section>
  </main>
</Base>
