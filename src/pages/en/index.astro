---
import Base from '../../layouts/Base.astro';
import HeroShowcase from '../../components/HeroShowcase.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import ProjectFilter from '../../components/ProjectFilter.astro';
import CopyEmailButton from '../../components/CopyEmailButton.astro';
import { capabilitiesEn, priorStackEn, profile } from '../../data/profile';
import { englishProjects } from '../../data/english';

const flagship = englishProjects.find((project) => project.number === '01')!;
const cockpitProject = englishProjects.find((project) => project.number === '18')!;
const webProjects = englishProjects.filter((project) => ['06', '07', '08'].includes(project.number));
const gamesAndAi = englishProjects.filter((project) => ['11', '12', '13'].includes(project.number));
const systems = englishProjects.filter((project) => ['02', '03', '04', '05', '09', '10', '14', '15', '16', '17'].includes(project.number));
const getGroup = (num: string) => (['06', '07', '08'].includes(num) ? 'web' : ['11', '12', '13'].includes(num) ? 'games' : 'systems');

const toCardProps = (p: (typeof englishProjects)[number]) => ({
  number: p.number,
  title: p.title,
  type: p.type,
  description: p.description,
  stack: p.stack,
  href: `/en/projects/${p.slug}/`,
  accent: p.accent ?? 'orange',
  variant: p.variant ?? 'screenshot',
  image: p.images?.[0]?.src,
  secondaryImage: p.images?.[1]?.src,
  imageAlt: p.images?.[0]?.alt,
  featured: p.number === '01',
  group: getGroup(p.number),
  isEnglish: true,
  liveUrl: p.liveUrl,
  repoUrl: p.repoUrl,
});
---
<Base
  lang="en"
  title={`${profile.name} | Multiplatform Software & Game Engineer`}
  description="Miguel Quevedo's portfolio: multiplatform apps (desktop, mobile, web) in Flutter and Rust, Unity C# & Roblox Luau games, Next.js/Astro web, and applied AI."
>
  <main id="contenido">
    <section class="hero wrap">
      <div class="hero-copy">
        <h1>Multiplatform software, Rust systems and shipped games.</h1>
        <p class="hero-lede">
          Rust systems (GPUI + MCP + P2P), Flutter/Kotlin multiplatform apps, formal verification (Lean 4 + VeriPB 3.0), Unity C# games, and Next.js/Astro sites.
        </p>
        <div class="hero-actions">
          <a class="button button-primary" href="#proyectos">Explore projects ↘</a>
          <a class="button button-outline" href="/en/lab/">Lab · 18 papers ↗</a>
        </div>
      </div>

      <HeroShowcase isEnglish={true} />
    </section>

    <section class="proof-strip wrap" aria-label="Selected strengths">
      <div class="reveal-on-scroll">
        <strong>Local P2P network</strong>
        <p>Device communication with deferred sync and Firebase to Supabase migration.</p>
      </div>
      <div class="reveal-on-scroll">
        <strong>Flutter + Rust + Kotlin</strong>
        <p>Desktop, mobile and web apps connected to native FFI logic.</p>
      </div>
      <div class="reveal-on-scroll">
        <strong>Unity C# · Flutter · Roblox</strong>
        <p>Decoupled C# core with automated tests, shared Flutter package and Luau.</p>
      </div>
    </section>

    <section class="section wrap" id="proyectos">
      <div class="section-heading">
        <div>
          <h2>Shipped products and systems</h2>
        </div>
        <p>Real captures from Meson, e-commerce, technical services, web prototypes, and games.</p>
      </div>

      <ProjectFilter isEnglish={true} />

      <div class="project-section-block">
        <div class="project-grid">
          <ProjectCard {...toCardProps(flagship)} />
          <ProjectCard {...toCardProps(cockpitProject)} featured={true} />
        </div>
        <div class="project-grid project-grid--3" style="margin-top: 22px;">
          {webProjects.map((project) => <ProjectCard {...toCardProps(project)} />)}
        </div>
      </div>

      <div class="project-section-block">
        <div class="subsection-heading">
          <h3>Interactive engines and applied AI</h3>
          <p>Brasas in both Flutter and Unity, El Pueblo del Faro in Roblox Studio, plus LLM tooling and Rust Bevy.</p>
        </div>
        <div class="project-grid project-grid--3">
          {gamesAndAi.map((project) => <ProjectCard {...toCardProps(project)} />)}
        </div>
      </div>

      <div class="project-section-block">
        <div class="subsection-heading">
          <h3>Architecture and interfaces inside Meson</h3>
          <p>Current Meson desktop screenshots and architectural previews without exposing private code or data.</p>
        </div>
        <div class="project-grid">
          {systems.map((project) => <ProjectCard {...toCardProps(project)} />)}
        </div>
      </div>
    </section>

    <section class="section skills-section" id="tecnologias">
      <div class="wrap">
        <div class="section-heading">
          <div>
            <h2>Tools for each layer</h2>
          </div>
          <p>Active verified stack separated clearly from prior coursework and pre-Git experience.</p>
        </div>
        <div class="capability-grid">
          {capabilitiesEn.map((group) => (
            <div class="capability-col reveal-on-scroll">
              <div class="capability-head">
                <span class="capability-index">{group.index}</span>
                <h3>{group.label}</h3>
              </div>
              <p>{group.detail}</p>
              <div class="skill-list">
                {group.skills.map((skill) => (
                  <span class={skill.core ? 'skill-chip skill-chip--core' : 'skill-chip'}>{skill.name}</span>
                ))}
              </div>
            </div>
          ))}
        </div>
        <div class="skills-footer reveal-on-scroll">
          <div>
            <strong>Prior stack &amp; product</strong>
            <div class="skill-list skill-list--compact">
              {priorStackEn.map((item) => <span class="skill-chip skill-chip--muted">{item}</span>)}
            </div>
          </div>
          <div>
            <strong>Languages &amp; lab (18 PDF papers)</strong>
            <p class="skills-note-inline">
              Spanish &amp; English (bilingual), Portuguese &amp; Italian (advanced), German &amp; Japanese (basic).
              The <a href="/en/lab/">lab</a> hosts 18 bilingual technical reports with PDFs (Cockpit, Meson, BaaS/RLS audit, certified SAT verification in Lean 4 / VeriPB 3.0.2, Brasas, and Raw Input telemetry) plus verified samples in Rust, C, Assembly, C++, Swift and PHP.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="section wrap architecture-section">
      <div class="section-heading">
        <div>
          <h2>Built for unstable connections</h2>
        </div>
        <p>Local operations do not depend on cloud availability for every action.</p>
      </div>
      <div class="architecture-grid">
        <div class="architecture-diagram reveal-on-scroll" aria-label="Point of sale, floor and kitchen devices communicate locally, then synchronize remotely">
          <div class="diagram-label">Meson local network · mDNS + AES-256-GCM</div>
          <div class="diagram-devices">
            <div class="arch-node"><strong>POS</strong><small>Cash + WAL</small></div>
            <div class="arch-node"><strong>Floor</strong><small>2.5D Tablets</small></div>
            <div class="arch-node"><strong>Kitchen</strong><small>KDS / ESC-POS</small></div>
          </div>
          <div class="diagram-connector" aria-hidden="true"></div>
          <div class="diagram-flow">Local LAN P2P bus (HLC + CRDT)</div>
          <div class="diagram-store">
            <strong>Local Isar & outbox queue</strong>
            <small>Transactional offline persistence</small>
          </div>
          <div class="diagram-arrow">↓ Deferred reconciliation on reconnect</div>
          <div class="diagram-cloud">
            <strong>Supabase / PostgreSQL</strong>
            <small>Multi-branch replication & cloud backup</small>
          </div>
        </div>
        <div class="architecture-copy reveal-on-scroll">
          <div><h3>Local work</h3><p>Devices can exchange changes over the restaurant network during an Internet outage.</p></div>
          <div><h3>Native network layer</h3><p>The Rust engine implements encrypted envelopes and replay controls.</p></div>
          <div><h3>NoSQL & SQL migration</h3><p>Hands-on data modeling across Isar, SQLite, MySQL and migrating Firebase / Cloud Firestore into Supabase / PostgreSQL.</p></div>
          <a class="text-link" href="/en/projects/red-p2p/">Explore the architecture ↗</a>
        </div>
      </div>
      <p class="architecture-caveat">During a power outage, devices need batteries and the local network needs backup power.</p>
    </section>

    <section class="section wrap about-section" id="sobre-mi">
      <figure class="about-portrait reveal-on-scroll">
        <img
          src="/images/miguel-avatar.webp"
          alt="Miguel Antonio Quevedo Simoza"
          class="about-portrait-img"
          width="800"
          height="1000"
          loading="lazy"
          decoding="async"
        />
        <figcaption class="about-portrait-caption">
          <strong>{profile.name}</strong>
          <span>Aragua, VE · Open to remote, hybrid & relocation · UBA 2027</span>
        </figcaption>
      </figure>
      <div class="about-copy reveal-on-scroll">
        <h2>Clean modules and broad delivery</h2>
        <p>
          I take concepts from 0-to-1 ideation and feedback-validated MVPs to working software with 1:1 "on-model"
          design fidelity, up-to-date AI prompt engineering, modular architecture and explicit dependency injection.
          Final-year Systems Engineering (Programming Concentration) student at Universidad Bicentenaria de Aragua
          (expected graduation: July 2027).
        </p>
        <p>
          I have led most of Meson's design and implementation across desktop, mobile and web, and supervised a Flutter
          collaborator's work. Full Meson source stays private; this site presents architecture, live captures and
          verifiable public code samples.
        </p>
        <a class="text-link" href="/en/projects/meson/">Read the Meson case ↗</a>
      </div>
    </section>

    <section class="contact-section" id="contacto">
      <div class="wrap contact-inner">
        <h2>Let's build useful software</h2>
        <p>{profile.locationEn} · Full-time or part-time · Open to international relocation.</p>
        <div class="contact-actions">
          <a class="button button-primary" href={`mailto:${profile.email}`}>Email ({profile.email}) ↗</a>
          <CopyEmailButton email={profile.email} isEnglish={true} />
          <a class="text-link" style="margin-top:0" href={profile.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn ↗</a>
          <a class="text-link" style="margin-top:0" href={profile.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a>
          <a class="text-link" style="margin-top:0" href="/en/cv/">CV / PDF ↗</a>
        </div>
      </div>
    </section>
  </main>
</Base>
