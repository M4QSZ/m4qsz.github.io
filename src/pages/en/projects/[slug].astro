---
import Base from '../../../layouts/Base.astro';
import ProjectDetailGallery from '../../../components/ProjectDetailGallery.astro';
import ProjectPreview from '../../../components/ProjectPreview.astro';
import { englishProjects } from '../../../data/english';

export function getStaticPaths() {
  return englishProjects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

const { project } = Astro.props;
const scope = project.number === '01' || Number(project.number) > 5 ? 'Independent product' : 'Meson subsystem';
const status = project.status ?? 'Reviewed implementation';
---
<Base
  lang="en"
  title={`${project.title} | Miguel`}
  description={project.description}
  pageLabel={`${project.number} · ${project.title}`}
>
  <main id="contenido" class="detail-main wrap">
    <a class="back-link" href="/en/">← Back to portfolio</a>
    <div class="detail-hero" data-scroll-label={`${project.number} · Overview`}>
      <div>
        <p class="section-kicker">CASE STUDY / {project.number}</p>
        <h1 class="long-title">{project.title}<span>.</span></h1>
        <p class="detail-lede">{project.description}</p>
      </div>
      <div class="detail-badge">
        {project.stack.slice(0, 2).join(' + ')}<br /><strong>{project.type.toUpperCase()}</strong>
      </div>
    </div>

    <div class="detail-meta">
      <div><span>PROJECT</span><strong>{scope}</strong></div>
      <div><span>TECHNOLOGIES</span><strong>{project.stack.join(' · ')}</strong></div>
      <div><span>STATUS</span><strong>{status}</strong></div>
    </div>

    {project.images && project.images.length > 0 ? (
      <ProjectDetailGallery images={project.images} isEnglish={true} />
    ) : (
      <div class="detail-schematic-stage">
        <ProjectPreview
          number={project.number}
          title={project.title}
          accent={project.accent ?? 'orange'}
          variant={project.variant ?? 'screenshot'}
          isEnglish={true}
        />
      </div>
    )}

    <div class="case-layout">
      <aside>{project.sections.map(([heading], index) => <span>0{index + 1} / {heading.toUpperCase()}</span>)}</aside>
      <div class="case-content">
        {project.sections.map(([heading, body], index) => (
          <section data-scroll-label={`0${index + 1} · ${heading}`}>
            <p class="section-kicker">0{index + 1} / {heading.toUpperCase()}</p>
            <h2>{heading}.</h2>
            <p>{body}</p>
          </section>
        ))}
      </div>
    </div>
    <div class="detail-actions"><a class="button button-outline" href="/en/">All projects ↗</a></div>
  </main>
</Base>
