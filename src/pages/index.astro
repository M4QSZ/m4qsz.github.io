---
import Base from '../layouts/Base.astro';
import HeroShowcase from '../components/HeroShowcase.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ProjectFilter from '../components/ProjectFilter.astro';
import CopyEmailButton from '../components/CopyEmailButton.astro';
import { capabilities, priorStack, profile, projects } from '../data/profile';

const flagshipProject = projects.find((project) => project.number === '01')!;
const cockpitProject = projects.find((project) => project.number === '18')!;
const webProjects = projects.filter((project) => ['06', '07', '08'].includes(project.number));
const mesonSystems = projects.filter((project) => ['02', '03', '04', '05', '09', '10', '14', '15', '16', '17'].includes(project.number));
const gamesAndAi = projects.filter((project) => ['11', '12', '13'].includes(project.number));
---
<Base
  title={`${profile.name} | Ingeniería de software y videojuegos`}
  description="Portafolio de Miguel Quevedo: apps multiplataforma (PC, móvil, web) en Flutter y Rust, videojuegos Unity C# y Roblox Luau, web Next.js/Astro e IA aplicada."
>
  <main id="contenido">
    <section class="hero wrap">
      <div class="hero-copy">
        <h1>Diseño la idea y construyo el sistema completo.</h1>
        <p class="hero-lede">
          Sistemas en Rust (GPUI + MCP + P2P), apps multiplataforma Flutter/Kotlin, verificación formal (Lean 4 + VeriPB 3.0), videojuegos Unity C# y web Next.js/Astro.
        </p>
        <div class="hero-actions">
          <a class="button button-primary" href="#proyectos">Explorar proyectos <span aria-hidden="true">↘</span></a>
          <a class="button button-outline" href="/laboratorio/">Laboratorio · 18 papers ↗</a>
        </div>
      </div>

      <HeroShowcase isEnglish={false} />
    </section>

    <section class="proof-strip wrap" aria-label="Especialidades destacadas">
      <div class="reveal-on-scroll">
        <strong>Red P2P de Meson</strong>
        <p>Comunicación local entre dispositivos y sincronización diferida Firebase y Supabase.</p>
      </div>
      <div class="reveal-on-scroll">
        <strong>Flutter + Rust + Kotlin</strong>
        <p>Apps para PC, móvil y web conectadas con lógica nativa mediante FFI.</p>
      </div>
      <div class="reveal-on-scroll">
        <strong>Unity C# · Flutter · Roblox</strong>
        <p>Núcleo desacoplado con pruebas automatizadas, paquete compartido y Luau.</p>
      </div>
    </section>

    <section class="section wrap" id="proyectos">
      <div class="section-heading">
        <div>
          <h2>Productos en producción y sistemas</h2>
        </div>
        <p>Capturas reales de Meson, web comercial, servicios técnicos, prototipos y videojuegos.</p>
      </div>

      <ProjectFilter isEnglish={false} />

      <div class="project-section-block">
        <div class="project-grid">
          <ProjectCard {...flagshipProject} featured={true} group="systems" isEnglish={false} />
          <ProjectCard {...cockpitProject} featured={true} group="systems" isEnglish={false} />
        </div>
        <div class="project-grid project-grid--3" style="margin-top: 22px;">
          {webProjects.map((project) => (
            <ProjectCard {...project} group="web" isEnglish={false} />
          ))}
        </div>
      </div>

      <div class="project-section-block">
        <div class="subsection-heading">
          <h3>Videojuegos, motores interactivos e IA</h3>
          <p>Versiones de Brasas en Flutter y Unity, Roblox Studio y experimentación con LLMs y Rust Bevy.</p>
        </div>
        <div class="project-grid project-grid--3">
          {gamesAndAi.map((project) => (
            <ProjectCard {...project} group="games" isEnglish={false} />
          ))}
        </div>
      </div>

      <div class="project-section-block">
        <div class="subsection-heading">
          <h3>Arquitectura e interfaces dentro de Meson</h3>
          <p>Capturas actuales de Meson y diagramas técnicos de sus subsistemas sin publicar código privado.</p>
        </div>
        <div class="project-grid">
          {mesonSystems.map((project) => (
            <ProjectCard {...project} group="systems" isEnglish={false} />
          ))}
        </div>
      </div>
    </section>

    <section class="section skills-section" id="tecnologias">
      <div class="wrap">
        <div class="section-heading">
          <div>
            <h2>Herramientas para cada capa</h2>
          </div>
          <p>Stack activo verificado en código junto a conocimientos previos de formación y proyectos anteriores.</p>
        </div>
        <div class="capability-grid">
          {capabilities.map((group) => (
            <div class="capability-col reveal-on-scroll">
              <div class="capability-head">
                <span class="capability-index">{group.index}</span>
                <h3>{group.label}</h3>
              </div>
              <p>{group.detail}</p>
              <div class="skill-list">
                {group.skills.map((skill) => (
                  <span class={skill.core ? 'skill-chip skill-chip--core' : 'skill-chip'}>{skill.name}</span>
                ))}
              </div>
            </div>
          ))}
        </div>
        <div class="skills-footer reveal-on-scroll">
          <div>
            <strong>Stack previo y producto</strong>
            <div class="skill-list skill-list--compact">
              {priorStack.map((item) => <span class="skill-chip skill-chip--muted">{item}</span>)}
            </div>
          </div>
          <div>
            <strong>Idiomas y laboratorio (18 papers con PDF)</strong>
            <p class="skills-note-inline">
              Español e inglés (bilingüe), portugués e italiano (avanzado), alemán y japonés (básico).
              El <a href="/laboratorio/">laboratorio</a> reúne 18 reportes técnicos bilingües con PDF (Cockpit, Meson, auditoría BaaS/RLS, verificación formal SAT en Lean 4 / VeriPB 3.0.2, Brasas y Raw Input) más muestras verificadas en Rust, C, ensamblador, C++, Swift y PHP.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="section wrap architecture-section">
      <div class="section-heading">
        <div>
          <h2>Preparado para conexiones inestables</h2>
        </div>
        <p>El trabajo local no depende de que la nube esté disponible en cada operación.</p>
      </div>
      <div class="architecture-grid">
        <div class="architecture-diagram reveal-on-scroll" aria-label="Dispositivos conectados por una red local con sincronización diferida">
          <div class="diagram-label">Red local Meson · mDNS + AES-256-GCM</div>
          <div class="diagram-devices">
            <div class="arch-node"><strong>Caja</strong><small>POS + WAL</small></div>
            <div class="arch-node"><strong>Sala</strong><small>Tablets 2.5D</small></div>
            <div class="arch-node"><strong>Cocina</strong><small>KDS / ESC-POS</small></div>
          </div>
          <div class="diagram-connector" aria-hidden="true"></div>
          <div class="diagram-flow">Bus P2P en red local (HLC + CRDT)</div>
          <div class="diagram-store">
            <strong>Cola e Isar local</strong>
            <small>Persistencia transaccional sin nube</small>
          </div>
          <div class="diagram-arrow">↓ Reconciliación diferida al reconectar</div>
          <div class="diagram-cloud">
            <strong>Supabase / PostgreSQL</strong>
            <small>Réplica multi-sucursal y respaldo</small>
          </div>
        </div>
        <div class="architecture-copy reveal-on-scroll">
          <div>
            <h3>Operación local</h3>
            <p>Los dispositivos pueden intercambiar acciones dentro de la red del restaurante aunque falle Internet.</p>
          </div>
          <div>
            <h3>Protocolo propio</h3>
            <p>El motor en Rust implementa sobres cifrados y una ventana de control de mensajes repetidos.</p>
          </div>
          <div>
            <h3>Migración NoSQL y SQL</h3>
            <p>Experiencia práctica conectando persistencia local (Isar, SQLite) y migrando entre Firebase / Cloud Firestore y Supabase / PostgreSQL o MySQL.</p>
          </div>
          <a class="text-link" href="/proyectos/red-p2p/">Explorar la arquitectura <span aria-hidden="true">↗</span></a>
        </div>
      </div>
      <p class="architecture-caveat">
        En un corte eléctrico, esta continuidad requiere dispositivos con batería y energía de respaldo para la red local; el software por sí solo no mantiene encendidos los equipos.
      </p>
    </section>

    <section class="section wrap about-section" id="sobre-mi">
      <figure class="about-portrait reveal-on-scroll">
        <img
          src="/images/miguel-avatar.webp"
          alt="Miguel Antonio Quevedo Simoza"
          class="about-portrait-img"
          width="800"
          height="1000"
          loading="lazy"
          decoding="async"
        />
        <figcaption class="about-portrait-caption">
          <strong>{profile.name}</strong>
          <span>Estado Aragua, Venezuela · Disponible remoto, híbrido y reubicación · UBA 2027</span>
        </figcaption>
      </figure>
      <div class="about-copy reveal-on-scroll">
        <h2>Código limpio y producto completo</h2>
        <p>
          Llevo ideas y conceptos a software funcional (0 a 1): prototipado rápido, MVP validado con retroalimentación,
          fidelidad visual 1:1 a diseño («on-model»), optimización de prompts con criterio actualizado de modelos de IA,
          arquitectura modular, separación entre interfaz y lógica e inyección de dependencias. Estudiante de último año
          de Ingeniería en Sistemas, mención Programación, en la Universidad Bicentenaria de Aragua (egreso estimado: julio 2027).
        </p>
        <p>
          He llevado la mayor parte del diseño e implementación de Meson (PC, móvil y web) y supervisé las entregas de un
          colaborador Flutter. El código completo de Meson es privado; aquí presento la arquitectura, capturas reales
          del sistema y muestras públicas verificables.
        </p>
        <a class="text-link" href="/proyectos/meson/">Leer el caso de estudio <span aria-hidden="true">↗</span></a>
      </div>
    </section>

    <section class="contact-section" id="contacto">
      <div class="wrap contact-inner">
        <h2>Construyamos algo útil</h2>
        <p>{profile.location} · Jornada completa o media jornada · Reubicación internacional.</p>
        <div class="contact-actions">
          <a class="button button-primary" href={`mailto:${profile.email}`}>Escribirme ({profile.email}) ↗</a>
          <CopyEmailButton email={profile.email} isEnglish={false} />
          <a class="text-link" style="margin-top:0" href={profile.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn ↗</a>
          <a class="text-link" style="margin-top:0" href={profile.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a>
          <a class="text-link" style="margin-top:0" href="/cv/">CV / PDF ↗</a>
        </div>
      </div>
    </section>
  </main>
</Base>
