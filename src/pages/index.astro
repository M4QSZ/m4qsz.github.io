---
import Base from '../layouts/Base.astro';
import { capabilities, profile, projects } from '../data/profile';
const featuredProjects = projects.filter((project) => ['01', '06', '07', '08'].includes(project.number));
const mesonSystems = projects.filter((project) => ['02', '03', '04', '05', '09', '10'].includes(project.number));
const gamesAndAi = projects.filter((project) => ['11', '12', '13'].includes(project.number));
---
<Base title={`${profile.name} — Ingeniería de software y videojuegos`} description="Portafolio de Miguel Quevedo: apps multiplataforma (PC, móvil, web) en Flutter y Rust, videojuegos Unity C# y Roblox Luau, web Next.js/Astro e IA aplicada.">
  <main id="contenido">
    <section class="hero wrap">
      <div class="hero-copy">
        <div class="eyebrow"><span class="status-dot"></span> {profile.availability}</div>
        <p class="hero-index">PORTAFOLIO / 2026</p>
        <h1>Diseño la idea.<br /><em>Construyo el sistema.</em></h1>
        <p class="hero-lede">{profile.headline}</p>
        <div class="hero-actions">
          <a class="button button-primary" href="#proyectos">Explorar proyectos <span aria-hidden="true">↘</span></a>
          <a class="button button-outline" href="/cv/">Ver / Imprimir CV <span aria-hidden="true">↗</span></a>
          <a class="button button-outline" href={profile.github} target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a>
        </div>
      </div>
      <div class="hero-visual" aria-label="Diagrama de las capas de trabajo: producto, interfaz, lógica y plataforma">
        <div class="visual-top"><span>MI FORMA DE TRABAJAR</span><span>01 / 04</span></div>
        <div class="visual-orbit orbit-one"></div><div class="visual-orbit orbit-two"></div>
        <div class="visual-center"><span>DE LA IDEA</span><strong>AL SOFTWARE</strong><span>QUE FUNCIONA</span></div>
        <div class="visual-node node-a">01 <strong>PRODUCTO</strong></div>
        <div class="visual-node node-b">02 <strong>INTERFAZ</strong></div>
        <div class="visual-node node-c">03 <strong>SISTEMAS</strong></div>
        <div class="visual-node node-d">04 <strong>VIDEOJUEGOS</strong></div>
        <div class="visual-bottom"><span>PC · Móvil · Web · Motores 2D/3D</span><span>↗</span></div>
      </div>
    </section>

    <div class="ticker" aria-label="Áreas de trabajo"><div>PC / MÓVIL / WEB <span>✳</span> FLUTTER + RUST <span>✳</span> P2P / OFFLINE <span>✳</span> UNITY C# <span>✳</span> SQL / NOSQL <span>✳</span> IA / LLMS</div></div>

    <section class="proof-strip wrap" aria-label="Especialidades destacadas">
      <div><span>01 / SISTEMAS</span><strong>Red P2P de Meson</strong><p>Comunicación local entre dispositivos y sincronización diferida Firebase → Supabase.</p></div>
      <div><span>02 / MULTIPLATAFORMA</span><strong>Flutter + Rust + Kotlin</strong><p>Apps para PC, móvil y web conectadas con lógica nativa mediante FFI.</p></div>
      <div><span>03 / VIDEOJUEGOS</span><strong>Unity C# · Flutter · Roblox</strong><p>Núcleo desacoplado con pruebas automatizadas, paquete compartido y Luau.</p></div>
    </section>

    <section class="section wrap" id="proyectos">
      <div class="section-heading"><div><p class="section-kicker">01 / TRABAJO</p><h2>Productos con<br /><em>contexto real.</em></h2></div><p>Proyectos independientes, sistemas internos de Meson y desarrollo de videojuegos.</p></div>
      <div class="project-grid">
        {featuredProjects.map((project) => (
          <a class={`project-card accent-${project.accent}`} href={project.href}>
            <div class="project-top"><span>{project.number} / PROYECTO</span><span class="card-arrow" aria-hidden="true">↗</span></div>
            <div class="project-art" aria-hidden="true"><span class="art-frame"><span class="art-grid"></span><span class="art-symbol">{project.number === '01' ? 'M' : project.number === '06' ? 'N' : '◇'}</span></span></div>
            <div class="project-copy"><p class="project-type">{project.type}</p><h3>{project.title}</h3><p>{project.description}</p><div class="tags">{project.stack.map((skill) => <span>{skill}</span>)}</div></div>
          </a>
        ))}
      </div>

      <div class="subsection-heading"><p class="section-kicker">VIDEOJUEGOS E IA</p><h3>Motores interactivos y prototipos.</h3><p>Versiones de Brasas en Flutter y Unity, Roblox Studio y experimentación con LLMs y Rust Bevy.</p></div>
      <div class="project-grid">
        {gamesAndAi.map((project) => (
          <a class={`project-card accent-${project.accent}`} href={project.href}>
            <div class="project-top"><span>{project.number} / INTERACTIVO</span><span class="card-arrow" aria-hidden="true">↗</span></div>
            {project.image ? (
              <div class="project-thumb"><img src={project.image} alt={project.imageAlt ?? project.title} loading="lazy" /></div>
            ) : (
              <div class="project-art" aria-hidden="true"><span class="art-frame"><span class="art-grid"></span><span class="art-symbol">{project.number === '12' ? '◈' : 'λ'}</span></span></div>
            )}
            <div class="project-copy"><p class="project-type">{project.type}</p><h3>{project.title}</h3><p>{project.description}</p><div class="tags">{project.stack.map((skill) => <span>{skill}</span>)}</div></div>
          </a>
        ))}
      </div>

      <div class="subsection-heading"><p class="section-kicker">DENTRO DE MESON</p><h3>Arquitectura e interfaces destacadas.</h3><p>Casos técnicos de un mismo producto privado, presentados sin publicar su código ni sus datos.</p></div>
      <div class="project-grid">
        {mesonSystems.map((project) => (
          <a class={`project-card accent-${project.accent}`} href={project.href}>
            <div class="project-top"><span>{project.number} / SISTEMA</span><span class="card-arrow" aria-hidden="true">↗</span></div>
            <div class="project-art" aria-hidden="true"><span class="art-frame"><span class="art-grid"></span><span class="art-symbol">{project.number === '02' ? '↔' : project.number === '03' ? '◫' : project.number === '04' ? '▣' : '◇'}</span></span></div>
            <div class="project-copy"><p class="project-type">{project.type}</p><h3>{project.title}</h3><p>{project.description}</p><div class="tags">{project.stack.map((skill) => <span>{skill}</span>)}</div></div>
          </a>
        ))}
      </div>
    </section>

    <section class="section skills-section" id="tecnologias"><div class="wrap">
      <div class="section-heading"><div><p class="section-kicker">02 / TECNOLOGÍAS</p><h2>Herramientas para<br /><em>cada capa.</em></h2></div><p>Stack activo verificado en código junto a conocimientos previos de formación y proyectos anteriores.</p></div>
      <div class="capability-grid capability-grid-3">{capabilities.map((group, index) => <div class="capability-card"><div class="capability-number">0{index + 1}</div><h3>{group.label}</h3><p>{group.detail}</p><div class="skill-list">{group.skills.map((skill) => <span>{skill}</span>)}</div></div>)}</div>
      <p class="skills-note">Idiomas: español e inglés (100% / bilingüe), portugués e italiano (avanzado), alemán y japonés (básico). El laboratorio añade muestras en Rust, C, ensamblador, C++, Swift y PHP con su estado de verificación.</p>
    </div></section>

    <section class="section wrap architecture-section"><div class="section-heading"><div><p class="section-kicker">03 / ARQUITECTURA</p><h2>Preparado para<br /><em>conexiones inestables.</em></h2></div><p>El trabajo local no depende de que la nube esté disponible en cada operación.</p></div>
      <div class="architecture-grid"><div class="architecture-diagram" aria-label="Dispositivos de caja, sala y cocina conectados por una red local, con sincronización posterior hacia la nube"><div class="diagram-label">RED LOCAL / MESON</div><div class="diagram-devices"><span>CAJA</span><span>SALA</span><span>COCINA</span></div><div class="diagram-flow">↔ &nbsp; DESCUBRIMIENTO + MENSAJES P2P &nbsp; ↔</div><div class="diagram-store">DATOS Y COLA LOCAL</div><div class="diagram-arrow">↓ cuando hay conexión</div><div class="diagram-cloud">NUBE / SINCRONIZACIÓN</div></div><div class="architecture-copy"><div><span>01</span><h3>Operación local</h3><p>Los dispositivos pueden intercambiar acciones dentro de la red del restaurante aunque falle Internet.</p></div><div><span>02</span><h3>Protocolo propio</h3><p>El motor en Rust implementa sobres cifrados y una ventana de control de mensajes repetidos.</p></div><div><span>03</span><h3>Migración NoSQL ↔ SQL</h3><p>Experiencia práctica conectando persistencia local (Isar, SQLite) y migrando entre Firebase / Cloud Firestore y Supabase / PostgreSQL o MySQL.</p></div><a class="text-link" href="/proyectos/red-p2p/">Explorar la arquitectura <span aria-hidden="true">↗</span></a></div></div>
      <p class="architecture-caveat">En un corte eléctrico, esta continuidad requiere dispositivos con batería y energía de respaldo para la red local; el software por sí solo no mantiene encendidos los equipos.</p>
    </section>

    <section class="section wrap about-section" id="sobre-mi"><div><p class="section-kicker">04 / ENFOQUE</p><h2>Código limpio.<br /><em>Producto completo.</em></h2></div><div class="about-copy"><p>Trabajo con arquitectura modular, separación entre interfaz y lógica, e inyección de dependencias para mantener archivos pequeños y legibles. Estudiante de último año de Ingeniería en Sistemas, mención Programación, en la Universidad Bicentenaria de Aragua (egreso estimado: julio 2027).</p><p>He llevado la mayor parte del diseño e implementación de Meson (PC, móvil y web) y supervisé las entregas de un colaborador Flutter. El código completo de Meson es privado; aquí presento la arquitectura, capturas reales de Brasas y muestras públicas.</p><a class="text-link" href="/proyectos/meson/">Leer el caso de estudio <span aria-hidden="true">↗</span></a></div></section>

    <section class="contact-section"><div class="wrap contact-inner"><p class="section-kicker">05 / CONTACTO</p><h2>Construyamos<br /><em>algo útil.</em></h2><p>{profile.location} · Disponible para oportunidades remotas.</p><div class="contact-actions"><a class="button button-primary" href={`mailto:${profile.email}`}>Escribirme ({profile.email}) ↗</a><a class="button button-outline" href={profile.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn ↗</a><a class="button button-outline" href={profile.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a><a class="button button-outline" href="/cv/">CV / PDF ↗</a></div></div></section>
  </main>
</Base>
